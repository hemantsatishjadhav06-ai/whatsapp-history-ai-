# Development only; never commit a completed .env.
ENVIRONMENT=development
DATABASE_URL=sqlite:///.local/assistant.db
# If blank in development, bootstrap creates a persistent local key in .local/.
# Production requires an externally managed Fernet key and PostgreSQL.
ENCRYPTION_KEY=
ALLOW_DEV_AUTH=false
SESSION_SECURE=true
SESSION_TTL_SECONDS=86400
ALLOWED_ORIGINS=http://localhost:3000
INTERNAL_SERVICE_TOKEN=
# Production selects Redis automatically and rejects memory/off limits.
REQUEST_LIMITS_MODE=auto
REQUEST_MAX_INFLIGHT=32
REQUEST_CONTROL_RESERVE=4
REQUEST_THREAD_TOKENS=48
REQUEST_DEFAULT_BODY_BYTES=65536
REQUEST_BODY_TIMEOUT_SECONDS=10
REQUEST_JSON_MAX_DEPTH=64
REQUEST_RATE_WINDOW_SECONDS=60
REQUEST_RATE_AUTH_ISSUES=30
REQUEST_RATE_AUTH_EXCHANGES=30
REQUEST_RATE_API=600
REQUEST_RATE_SOURCE_API=6000
REQUEST_RATE_GLOBAL_API=60000
REQUEST_RATE_CONTROL=120
REQUEST_RATE_SOURCE_CONTROL=120
REQUEST_RATE_GLOBAL_CONTROL=6000
REQUEST_RATE_GLOBAL_AUTH=6000
REQUEST_RATE_NAMESPACE=milo-request-v1
# Separate key matching web BACKEND_PROXY_KEY, with >=32 random bytes.
# Set only when the web deployment validates an explicitly trusted ingress hop.
TRUSTED_PROXY_KEY=
# Connection ceiling is (pool + overflow) times API processes/replicas/workers.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=3
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=15000
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
NATIVE_SESSION_TTL_SECONDS=3600
NATIVE_REFRESH_TTL_SECONDS=2592000
MODEL_PROVIDER=disabled
MODEL_API_KEY=
MODEL_NAME=
MODEL_API_URL=https://api.openai.com/v1
# Record verified provider configuration before any real customer model processing.
MODEL_PROCESSING_REGION=unconfigured
MODEL_DATA_USE_CONFIGURATION=unconfigured
# Optional verified, model-specific rates for enforcing a real model cost ceiling.
MODEL_PRICING_VERIFIED=false
MODEL_PRICING_MODEL_NAME=
# If configured, use integer micro-USD per one million tokens.
# MODEL_INPUT_COST_MICROUSD_PER_MILLION=0
# MODEL_OUTPUT_COST_MICROUSD_PER_MILLION=0
ENABLE_EXTERNAL_SENDS=false
# Optional authenticated mock action bridge; HTTP is allowed only on loopback.
CONNECTOR_GATEWAY_URL=
CONNECTOR_GATEWAY_TOKEN=
CONNECTOR_GATEWAY_TIMEOUT_SECONDS=10
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Exact raw Google ID-token sub for the operator who owns this configured number.
# Blank denies Business connector claims/verification/sending/webhook retention.
# This is not an email, role, client-submitted value or a google:-prefixed subject.
WHATSAPP_AUTHORIZED_OWNER_SUBJECT=
WHATSAPP_API_VERSION=v23.0
# Optional development containers; supply a local random password before starting.
POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
WORKFLOW_TASK_QUEUE=assistant-schedules
