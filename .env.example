# Development only; never commit a completed .env.
ENVIRONMENT=development
DATABASE_URL=sqlite:///.local/assistant.db
# If blank in development, bootstrap creates a persistent local key in .local/.
# Production requires an externally managed Fernet key and PostgreSQL.
ENCRYPTION_KEY=
ALLOW_DEV_AUTH=false
SESSION_SECURE=true
SESSION_TTL_SECONDS=86400
ALLOWED_ORIGINS=http://localhost:3000
INTERNAL_SERVICE_TOKEN=
# Optional pilot owner sign-in (no Google): one random secret of at least 32 characters.
# The owner enters it on /login. Keep it out of chats and rotate it like a password.
OWNER_ACCESS_CODE=
# Production selects Redis automatically and rejects memory/off limits.
REQUEST_LIMITS_MODE=auto
REQUEST_MAX_INFLIGHT=32
REQUEST_CONTROL_RESERVE=4
REQUEST_THREAD_TOKENS=48
REQUEST_DEFAULT_BODY_BYTES=65536
REQUEST_BODY_TIMEOUT_SECONDS=10
REQUEST_JSON_MAX_DEPTH=64
REQUEST_RATE_WINDOW_SECONDS=60
REQUEST_RATE_AUTH_ISSUES=30
REQUEST_RATE_AUTH_EXCHANGES=30
REQUEST_RATE_API=600
REQUEST_RATE_SOURCE_API=6000
REQUEST_RATE_GLOBAL_API=60000
REQUEST_RATE_CONTROL=120
REQUEST_RATE_SOURCE_CONTROL=120
REQUEST_RATE_GLOBAL_CONTROL=6000
REQUEST_RATE_GLOBAL_AUTH=6000
REQUEST_RATE_NAMESPACE=milo-request-v1
# Separate key matching web BACKEND_PROXY_KEY, with >=32 random bytes.
# Set only when the web deployment validates an explicitly trusted ingress hop.
TRUSTED_PROXY_KEY=
# Connection ceiling is (pool + overflow) times API processes/replicas/workers.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=3
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=15000
GOOGLE_CLIENT_ID=
# Web Identity Services needs the public Web OAuth client ID. The native HTTPS
# broker additionally uses the same client's server-only secret and registered
# callback; these secrets never belong in EXPO_PUBLIC_* or NEXT_PUBLIC_* values.
GOOGLE_CLIENT_SECRET=
GOOGLE_NATIVE_REDIRECT_URI=
GOOGLE_NATIVE_APP_REDIRECT_URI=milo://oauth
# Legacy directly verified installed-client tokens remain a separate API path.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
NATIVE_SESSION_TTL_SECONDS=3600
NATIVE_REFRESH_TTL_SECONDS=2592000
MODEL_PROVIDER=disabled
MODEL_API_KEY=
MODEL_NAME=
MODEL_API_URL=https://api.openai.com/v1
# OpenRouter: MODEL_PROVIDER=openrouter, MODEL_API_KEY=sk-or-..., and a model with
# structured-output support such as MODEL_NAME=openai/gpt-4o-mini. The URL defaults
# to https://openrouter.ai/api/v1. Set the same values on the API and Jobs services.
# MODEL_APP_URL=
# MODEL_APP_TITLE=Milo
# Default per-owner daily model token allowance when no workspace budget exists (0 = off).
MODEL_DEFAULT_DAILY_TOKENS=1000000
MODEL_MAX_CONCURRENCY=4
MODEL_MAX_CONCURRENCY_PER_OWNER=1
# Record verified provider configuration before any real customer model processing.
MODEL_PROCESSING_REGION=unconfigured
MODEL_DATA_USE_CONFIGURATION=unconfigured
# Optional verified, model-specific rates for enforcing a real model cost ceiling.
MODEL_PRICING_VERIFIED=false
MODEL_PRICING_MODEL_NAME=
# If configured, use integer micro-USD per one million tokens.
# MODEL_INPUT_COST_MICROUSD_PER_MILLION=0
# MODEL_OUTPUT_COST_MICROUSD_PER_MILLION=0
ENABLE_EXTERNAL_SENDS=false
# Optional authenticated mock action bridge; HTTP is allowed only on loopback.
CONNECTOR_GATEWAY_URL=
CONNECTOR_GATEWAY_TOKEN=
CONNECTOR_GATEWAY_TIMEOUT_SECONDS=10
# Optional private server-held linked-device pilot, separate from Business.
# Keep disabled until a private QR service with matching strong tokens is ready.
WHATSAPP_PERSONAL_ENABLED=false
WHATSAPP_PERSONAL_SESSION_URL=
WHATSAPP_PERSONAL_SESSION_TOKEN=
# Dedicated token the session service presents to the API's two session-authority
# routes (set it as PYTHON_INTERNAL_TOKEN on that service). Required in production;
# it never authorizes other /internal routes. Must differ from every other secret.
WHATSAPP_PERSONAL_AUTHORITY_TOKEN=
WHATSAPP_PERSONAL_TIMEOUT_SECONDS=10
# The dedicated Node service additionally needs SESSION_GATEWAY_TOKEN,
# PYTHON_INTERNAL_TOKEN, PYTHON_AUTHORITY_URL and a base64 32-byte
# SESSION_ENCRYPTION_KEY. Configure these securely on that service, never here
# with live values. ENABLE_PERSONAL_WHATSAPP=true; MAX_PERSONAL_SESSIONS=20.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Exact raw Google ID-token sub for the operator who owns this configured number.
# Blank denies Business connector claims/verification/sending/webhook retention.
# This is not an email, role, client-submitted value or a google:-prefixed subject.
WHATSAPP_AUTHORIZED_OWNER_SUBJECT=
WHATSAPP_API_VERSION=v23.0
# Optional development containers; supply a local random password before starting.
POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
WORKFLOW_TASK_QUEUE=assistant-schedules
