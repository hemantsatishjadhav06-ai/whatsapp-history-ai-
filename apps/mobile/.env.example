# Public build configuration only. Never put Google/model/provider secrets here.
EXPO_PUBLIC_MILO_ENV=development
# A trusted HTTPS API origin, without a path, query, credentials or fragment.
EXPO_PUBLIC_API_URL=https://api.example.invalid
# Loopback HTTP is allowed only for development; Android emulators need a tested
# device-reachable HTTPS origin. Google installed-app client IDs come from the
# API's public /v1/auth/config, not from bundled secrets or extra environment keys.
# The consumed redirect is generated from app.json: milo://oauth. Register the
# actual development/preview/production build redirect with the identity provider.
