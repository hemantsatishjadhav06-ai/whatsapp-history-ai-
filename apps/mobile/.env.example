# Public build configuration only. Never put Google/model/provider secrets here.
EXPO_PUBLIC_MILO_ENV=preview
# Trusted HTTPS Milo API origin, optionally with the exact /native-api prefix.
# The dedicated native proxy never uses browser cookies or browser session tokens.
EXPO_PUBLIC_API_URL=https://web-production-bde60.up.railway.app/native-api
# Loopback HTTP is allowed only for development; Android emulators need a tested
# device-reachable HTTPS origin. The API's public /v1/auth/config controls Google
# availability. Google receives the server's registered HTTPS callback, never a
# custom native redirect. The system browser returns only a one-use proof-bound
# handoff at milo://oauth, defined by app.json. Server GOOGLE_CLIENT_SECRET stays
# private; no Google/model/provider secret or bearer is embedded in this file.
