    "event_type": {
      "default": "message.created",
      "enum": [
        "message.created",
        "message.edited",
        "message.deleted",
        "reaction.added",
        "reaction.removed"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "author_kind": {
      "anyOf": [
        {
          "enum": [
            "contact_human",
            "human_owner",
            "assistant",
            "other_authorized_operator",
            "unknown_owner_outgoing"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author Kind"
    },
    "provider_timestamp": {
      "format": "date-time",
      "title": "Provider Timestamp",
      "type": "string"
    },
    "received_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Received At"
    },
    "content": {
      "$ref": "#/$defs/EventContent"
    },
    "reply_to": {
      "anyOf": [
        {
          "maxLength": 180,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reply To"
    },
    "source_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Source Revision",
      "type": "integer"
    },
    "sender_identity": {
      "additionalProperties": true,
      "title": "Sender Identity",
      "type": "object"
    },
    "participant_identity": {
      "additionalProperties": true,
      "title": "Participant Identity",
      "type": "object"
    },
    "provider_record_ref": {
      "anyOf": [
        {
          "maxLength": 180,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Record Ref"
    },
    "native_record": {
      "anyOf": [
        {
          "$ref": "#/$defs/NativeOriginal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reaction": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReactionContent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "deleted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deleted At"
    },
    "owner_addressed": {
      "default": false,
      "title": "Owner Addressed",
      "type": "boolean"
    }
  },
  "required": [
    "event_id",
    "connector_id",
    "conversation_id",
    "provider_message_id",
    "sender_id",
    "direction",
    "origin",
    "provider_timestamp"
  ],
  "title": "CanonicalEvent",
  "type": "object"
}
