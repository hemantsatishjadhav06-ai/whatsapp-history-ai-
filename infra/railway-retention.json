{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/api/Dockerfile.railway",
    "watchPatterns": ["/services/api/**", "/db/**", "/pyproject.toml", "/uv.lock", "/alembic.ini", "/infra/railway-retention.json"]
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "/bin/sh -c '/app/.venv/bin/python -m assistant.render_entrypoint wait-schema --timeout 300 && exec /app/.venv/bin/python -m assistant.lifecycle'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
