{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/api/Dockerfile",
    "watchPatterns": ["/services/api/**", "/db/**", "/pyproject.toml", "/uv.lock", "/infra/railway-actions.json"]
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "/app/.venv/bin/python -m assistant.actions",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
