{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/api/Dockerfile",
    "watchPatterns": ["/services/api/**", "/db/**", "/pyproject.toml", "/uv.lock", "/alembic.ini", "/infra/railway-api.json"]
  },
  "deploy": {
    "preDeployCommand": "/app/.venv/bin/alembic upgrade head",
    "startCommand": "/bin/sh -c 'exec /app/.venv/bin/uvicorn assistant.main:create_app --factory --host \"\" --port ${PORT:-8000} --no-access-log'",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
