{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/whatsapp-session/Dockerfile",
    "watchPatterns": [
      "/services/whatsapp-session/**",
      "/infra/railway-whatsapp-session.json",
      "/infra/railway-service-settings.json"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "node src/runtime.ts",
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
