# Railway web service: leave unset for the isolated synthetic demo.
# Set this only in the service runtime environment, never in a client bundle.
# Local API: http://127.0.0.1:8000
# Railway example after creating the API service: http://milo-api.railway.internal:8000
BACKEND_URL=
# Required for authenticated writes behind public HTTPS ingress.
# Example: https://your-domain.up.railway.app
PUBLIC_APP_ORIGIN=
PORT=3000
NEXT_TELEMETRY_DISABLED=1
# Optional signed rate-limit source for the private API. Server runtime only.
# Match the API's dedicated TRUSTED_PROXY_KEY; use at least 32 random characters.
# Never reuse an app session key or connector/internal service token.
BACKEND_PROXY_KEY=
# Defaults to zero: ignore requester forwarding headers and use the API peer.
# Enable only after verifying the deployment ingress appends/overwrites a trusted
# X-Forwarded-For suffix. Select the Nth address from the right (1 = rightmost).
# Every relied-on hop must be verified; this setting does not verify the edge.
TRUST_PROXY_HOPS=0
